{{/*
  Hugo 내장 sitemap.xml 의 오버라이드.

  내장본과 다른 곳은 한 군데다: `seo/thin-term.html` 이 참이라고 한
  분류 페이지를 목록에서 뺀다. 글이 1~2 편뿐인 태그·카테고리 페이지는
  같은 문서에 noindex 를 내보내고 있으므로, 사이트맵에 남겨 두면
  "제출했는데 색인하지 말라는 페이지" 로 Search Console 에 경고가 쌓인다.

  나머지(lastmod, changefreq, priority, hreflang 대체 링크)는 내장본
  그대로다. 테마를 올릴 때 내장본과 diff 해서 따라가면 된다.

  hreflang 값은 `.Language.Locale` 을 쓴다. 내장본의
  `.Language.LanguageCode` 는 Hugo 0.158 에서 폐기됐고, HTML 의
  hreflang(custom-head.html)도 Locale 을 쓰고 있어 값이 어긋나면 안 된다.
*/ -}}
{{ printf "<?xml version=%q encoding=%q?>" "1.0" "utf-8" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{- range .Pages }}
    {{- if partial "seo/thin-term.html" . }}{{ continue }}{{ end }}
    {{- with .Sitemap.Disable }}{{ continue }}{{ end }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</lastmod>
    {{- end }}
    {{- with .Sitemap.ChangeFreq }}
    <changefreq>{{ . }}</changefreq>
    {{- end }}
    {{- if ge .Sitemap.Priority 0.0 }}
    <priority>{{ .Sitemap.Priority }}</priority>
    {{- end }}
    {{- if .IsTranslated }}
      {{- range .AllTranslations }}
    <xhtml:link rel="alternate" hreflang="{{ .Language.Locale }}" href="{{ .Permalink }}"/>
      {{- end }}
    {{- end }}
  </url>
  {{- end }}
</urlset>
